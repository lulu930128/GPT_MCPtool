# Set these in the process environment; this component does not load .env files.
LISTENING_MCP_HOST=127.0.0.1
LISTENING_MCP_PORT=18810
LISTENING_TRAINER_BASE_URL=http://127.0.0.1:8765
LISTENING_REQUEST_TIMEOUT_MS=300000
LISTENING_MAX_QUESTIONS=20
LISTENING_MAX_TEXT_LENGTH=5000
# Optional bearer authentication. Do not expose a tunnel before configuring auth.
# LISTENING_MCP_HTTP_TOKEN=<replace-in-local-environment>
