{
  "schemaVersion": 2,
  "settings": {
    "initialDelaySeconds": 12,
    "betweenComponentsSeconds": 3,
    "probeTimeoutSeconds": 2,
    "postStartTimeoutSeconds": 45,
    "controllerActionTimeoutSeconds": 180,
    "refreshIntervalSeconds": 30,
    "eventRetentionDays": 30
  },
  "components": [
    {
      "id": "project_reading",
      "displayName": "Project Reading",
      "root": "..\\..\\project_reading",
      "runtimeMode": "component-controller",
      "contractScript": "scripts\\runtime-control.ps1",
      "autoStart": true,
      "startupOrder": 10,
      "legacyStartup": {
        "shortcutName": "GPT Workspace MCP.lnk",
        "launcher": "scripts\\start-tray.vbs"
      },
      "actions": {
        "ensure_running": { "kind": "powershell", "path": "scripts\\runtime-control.ps1" },
        "repair_connectivity": { "kind": "powershell", "path": "scripts\\runtime-control.ps1" },
        "restart_core": { "kind": "powershell", "path": "scripts\\runtime-control.ps1" },
        "reload_runtime": { "kind": "powershell", "path": "scripts\\runtime-control.ps1" },
        "shutdown_runtime": { "kind": "powershell", "path": "scripts\\runtime-control.ps1" },
        "show_diagnostic_tray": { "kind": "vbs", "path": "scripts\\show-diagnostic-tray.vbs" }
      },
      "probes": [
        {
          "id": "mcp",
          "label": "MCP server",
          "role": "core",
          "kind": "json",
          "url": "http://127.0.0.1:18787/health",
          "port": 18787,
          "required": true,
          "expected": { "ok": true, "service": "gpt-project-workspace-mcp" },
          "summaryFields": ["service"],
          "ownerCommandContains": ["project_reading", "dist\\src\\http-main.js"]
        },
        {
          "id": "tunnel",
          "label": "Secure MCP Tunnel",
          "role": "connectivity",
          "kind": "text",
          "url": "http://127.0.0.1:18788/readyz",
          "port": 18788,
          "required": true,
          "expectedText": ["ready", "ok"],
          "ownerCommandContains": ["project_reading", "tunnel-client"]
        }
      ]
    },
    {
      "id": "omi_search",
      "displayName": "OMI Search",
      "root": "..\\..\\OMI_search",
      "runtimeMode": "legacy-tray",
      "contractScript": "scripts\\tray.ps1",
      "autoStart": true,
      "startupOrder": 20,
      "legacyStartup": {
        "shortcutName": "OMI_search MCP Adapter.lnk",
        "launcher": "scripts\\start-tray.vbs"
      },
      "actions": {
        "start": { "kind": "vbs", "path": "scripts\\start-tray.vbs" },
        "restart": { "kind": "vbs", "path": "scripts\\restart-tray.vbs" }
      },
      "probes": [
        {
          "id": "omi_backend",
          "label": "OMI backend",
          "role": "dependency",
          "kind": "json",
          "url": "http://127.0.0.1:18797/upstream-health",
          "port": 18797,
          "required": true,
          "expected": { "ok": true, "status": "ready" },
          "summaryFields": ["service", "status", "errorCode"]
        },
        {
          "id": "mcp",
          "label": "MCP server",
          "role": "core",
          "kind": "json",
          "url": "http://127.0.0.1:18797/health",
          "port": 18797,
          "required": true,
          "expected": { "ok": true, "service": "omi-search-http-mcp" },
          "summaryFields": ["service", "version", "buildId", "omi_api_base_url"],
          "ownerCommandContains": ["OMI_search", "http_server.py"]
        },
        {
          "id": "tunnel",
          "label": "Secure MCP Tunnel",
          "role": "connectivity",
          "kind": "text",
          "url": "http://127.0.0.1:18799/readyz",
          "port": 18799,
          "required": true,
          "expectedText": ["ready", "ok"],
          "ownerCommandContains": ["OMI_search", "tunnel-client"]
        }
      ]
    },
    {
      "id": "japanese_study",
      "displayName": "Japanese Study",
      "root": "..\\..\\japanese_study",
      "runtimeMode": "legacy-tray",
      "contractScript": "scripts\\tray.ps1",
      "autoStart": true,
      "startupOrder": 30,
      "legacyStartup": {
        "shortcutName": "Japanese Study Hub.lnk",
        "launcher": "scripts\\start-tray.vbs"
