          "summaryFields": ["service", "version", "buildId", "controller"],
          "ownerCommandContains": ["codex_bridge", "dist\\src\\http-main.js"]
        },
        {
          "id": "tunnel",
          "label": "Secure MCP Tunnel",
          "role": "connectivity",
          "kind": "text",
          "url": "http://127.0.0.1:18829/readyz",
          "port": 18829,
          "required": true,
          "expectedText": ["ready", "ok"],
          "ownerCommandContains": ["codex_bridge", "tunnel-client"]
        }
      ]
    },
    {
      "id": "personal_asset_os",
      "displayName": "Personal Asset OS",
      "root": "..\\..\\personal-asset-os",
      "runtimeMode": "legacy-tray",
