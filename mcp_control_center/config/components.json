          "url": "http://127.0.0.1:18790/health",
          "port": 18790,
          "required": true,
          "expected": { "ok": true, "service": "japanese-study-mcp" },
          "summaryFields": ["service", "version", "contractVersion", "buildId", "toolCount"],
          "ownerCommandContains": ["japanese_study", "dist\\src\\http-main.js"]
        },
        {
          "id": "tunnel",
          "label": "Secure MCP Tunnel",
          "role": "connectivity",
          "kind": "text",
          "url": "http://127.0.0.1:18792/readyz",
          "port": 18792,
          "required": true,
          "expectedText": ["ready", "ok"],
          "ownerCommandContains": ["japanese_study", "tunnel-client"]
        }
      ]
    },
    {
      "id": "memory_core",
      "displayName": "Memory Core",
      "root": "..\\..\\Memory Core",
      "runtimeMode": "legacy-tray",
      "contractScript": "scripts\\memory_core_tray.ps1",
      "autoStart": true,
      "startupOrder": 40,
      "legacyStartup": {
        "shortcutName": "Memory Core MCP.lnk",
        "launcher": "scripts\\start-memory-core-tray.vbs"
      },
      "actions": {
        "start": { "kind": "vbs", "path": "scripts\\start-memory-core-tray.vbs" },
        "restart": {
          "kind": "powershell",
          "path": "scripts\\memory_core_stack.ps1",
          "arguments": ["-Action", "Restart"],
          "wait": true
        }
      },
      "probes": [
        {
          "id": "backend",
          "label": "Memory Core backend",
          "role": "core",
          "kind": "json",
          "url": "http://127.0.0.1:18765/health",
          "port": 18765,
          "required": true,
          "expected": { "status": "ok", "database": "ok" },
          "summaryFields": ["status", "database", "version"],
          "ownerCommandContains": ["memory_core.main:app"],
          "ownerManagedPidFile": "data\\runtime\\backend.pid",
          "ownerManagedCommandContains": ["Memory Core", "memory_core.main:app"]
        },
        {
          "id": "mcp",
          "label": "MCP server",
          "role": "core",
          "kind": "json",
          "url": "http://127.0.0.1:18818/health",
          "port": 18818,
          "required": true,
          "expected": { "status": "ok", "service": "memory-core-mcp" },
          "summaryFields": ["status", "service", "version"],
          "ownerCommandContains": ["memory_core.mcp.main"],
          "ownerManagedPidFile": "data\\runtime\\mcp.pid",
          "ownerManagedCommandContains": ["Memory Core", "memory_core.mcp.main"]
        },
        {
          "id": "tunnel",
          "label": "Secure MCP Tunnel",
          "role": "connectivity",
          "kind": "text",
          "url": "http://127.0.0.1:18800/readyz",
          "port": 18800,
          "required": true,
          "expectedText": ["ready", "ok"],
          "ownerCommandContains": ["memory-core", "tunnel-client"]
        }
      ]
    },
    {
      "id": "codex_bridge",
      "displayName": "Codex Bridge",
      "root": "..\\..\\codex_bridge",
