{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/mcp-control-center/component-descriptor-v1.schema.json",
  "title": "MCP Control Center Component Descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "displayName",
    "runtimeMode",
    "runtimeContract",
    "traits",
    "contractScript",
    "capabilities",
    "lifecycle",
    "probes",
    "navigation",
    "safety"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "runtimeMode": {
      "enum": ["legacy-tray", "component-controller"]
    },
    "runtimeContract": {
      "enum": ["unified-always-on-v2", "unified-lifecycle-v3"]
    },
    "traits": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "tunnel",
          "external-dependency",
          "multi-core",
          "data-sensitive",
          "credential-sensitive",
          "approval-sensitive",
          "primary-ui",
          "diagnostic-ui"
        ]
      }
    },
    "contractScript": {
      "type": "string",
      "minLength": 1,
      "maxLength": 260
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "ensure_running",
          "repair_connectivity",
          "restart_core",
          "reload_runtime",
          "shutdown_runtime",
          "show_diagnostic_tray"
        ]
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ensureLauncher": { "$ref": "#/$defs/vbsLauncher" },
        "reloadLauncher": { "$ref": "#/$defs/vbsLauncher" },
        "controller": { "$ref": "#/$defs/powershellController" },
        "diagnosticLauncher": { "$ref": "#/$defs/vbsLauncher" }
      }
    },
    "legacyStartup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shortcutName", "launcher"],
      "properties": {
        "shortcutName": {
          "type": "string",
          "minLength": 5,
          "maxLength": 128,
          "pattern": "\\.[lL][nN][kK]$"
        },
        "launcher": {
          "type": "string",
          "minLength": 1,
          "maxLength": 260
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "postStartTimeoutSeconds": { "type": "integer", "minimum": 5, "maximum": 300 },
        "controllerActionTimeoutSeconds": { "type": "integer", "minimum": 5, "maximum": 300 }
      }
    },
    "probes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/probe" }
    },
    "navigation": {
      "type": "array",
      "maxItems": 16,
      "items": { "$ref": "#/$defs/navigation" }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "primaryLauncher": { "$ref": "#/$defs/vbsLauncher" },
        "menuContract": { "const": "component-menu-v1" },
        "actionEntrypoint": { "$ref": "#/$defs/powershellController" },
        "menuActions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": { "$ref": "#/$defs/menuAction" }
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["managerDomainDataAccess", "managerSecretAccess", "shutdownConfirmation"],
      "properties": {
        "managerDomainDataAccess": { "const": "none" },
        "managerSecretAccess": { "const": "none" },
        "shutdownConfirmation": { "const": "required" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "runtimeMode": { "const": "legacy-tray" } },
        "required": ["runtimeMode"]
      },
      "then": {
        "properties": {
          "runtimeContract": { "const": "unified-always-on-v2" },
          "capabilities": {
            "minItems": 2,
            "maxItems": 2,
            "allOf": [
              { "contains": { "const": "ensure_running" } },
              { "contains": { "const": "reload_runtime" } }
            ]
          },
          "lifecycle": {
            "required": ["ensureLauncher", "reloadLauncher"],
            "not": {
              "anyOf": [
                { "required": ["controller"] },
                { "required": ["diagnosticLauncher"] }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "runtimeMode": { "const": "component-controller" } },
        "required": ["runtimeMode"]
      },
      "then": {
        "properties": {
          "runtimeContract": { "const": "unified-lifecycle-v3" },
          "capabilities": {
            "minItems": 3,
            "allOf": [
              { "contains": { "const": "ensure_running" } },
              { "contains": { "const": "reload_runtime" } },
              { "contains": { "const": "shutdown_runtime" } }
            ]
          },
          "lifecycle": {
            "required": ["controller"],
            "not": {
              "anyOf": [
                { "required": ["ensureLauncher"] },
                { "required": ["reloadLauncher"] }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "runtimeMode": { "const": "component-controller" },
          "capabilities": { "contains": { "const": "show_diagnostic_tray" } }
        },
        "required": ["runtimeMode", "capabilities"]
      },
      "then": {
        "properties": {
          "traits": { "contains": { "const": "diagnostic-ui" } }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ui": {
            "anyOf": [
              { "required": ["menuContract"] },
              { "required": ["actionEntrypoint"] },
              { "required": ["menuActions"] }
            ]
          }
        },
        "required": ["ui"]
      },
      "then": {
        "properties": {
          "runtimeMode": { "const": "component-controller" },
          "ui": { "required": ["menuContract", "actionEntrypoint", "menuActions"] }
        }
      }
    }
  ],
  "$defs": {
    "vbsLauncher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path"],
      "properties": {
        "kind": { "const": "vbs" },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 260,
          "pattern": "\\.[vV][bB][sS]$"
        }
      }
    },
    "powershellController": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path"],
      "properties": {
        "kind": { "const": "powershell" },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 260,
          "pattern": "\\.[pP][sS]1$"
        }
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        { "required": ["commandContains"] },
        { "required": ["managedPidFile"] }
      ],
      "dependentRequired": {
        "managedCommandContains": ["managedPidFile"]
      },
      "properties": {
        "commandContains": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 160 }
        },
        "managedPidFile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 260
        },
        "managedCommandContains": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 160 }
        }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "role", "kind", "url", "port", "required"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "role": { "enum": ["core", "dependency", "connectivity"] },
        "kind": { "enum": ["json", "text"] },
        "url": { "type": "string", "minLength": 1, "maxLength": 512 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "required": { "type": "boolean" },
        "expected": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": ["string", "number", "integer", "boolean", "null"]
          }
        },
        "expectedText": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        },
        "publicSummaryFields": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "enum": [
              "service",
              "status",
              "version",
              "buildId",
              "contractVersion",
              "toolCount",
              "database",
              "schemaRevision",
              "ready",
              "databaseReady",
              "frontendReady",
              "errorCode"
            ]
          }
        },
        "ownership": { "$ref": "#/$defs/ownership" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "json" } }, "required": ["kind"] },
          "then": { "required": ["expected"], "not": { "required": ["expectedText"] } }
        },
        {
          "if": { "properties": { "kind": { "const": "text" } }, "required": ["kind"] },
          "then": { "required": ["expectedText"], "not": { "required": ["expected"] } }
        }
      ]
    },
    "navigation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind", "target"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "kind": { "enum": ["probe", "component-path", "loopback-url"] },
        "target": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "menuAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "group", "confirmation"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "group": { "enum": ["connection", "component"] },
        "confirmation": { "enum": ["none", "required"] }
      }
    }
  }
}
