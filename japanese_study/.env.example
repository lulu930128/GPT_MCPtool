JSTUDY_HUB_BASE_URL=http://127.0.0.1:18791
JSTUDY_HUB_API_TOKEN=
JSTUDY_HUB_TIMEOUT_MS=10000

JSTUDY_MCP_HOST=127.0.0.1
JSTUDY_MCP_PORT=18790

# Optional on loopback. Configure before exposing the MCP listener without the
# Secure MCP Tunnel trust boundary.
JSTUDY_MCP_HTTP_TOKEN=

# Secure MCP Tunnel settings are managed by scripts/tunnel.ps1. Keep the tunnel
# id in the ignored generated profile and save the runtime key with the DPAPI
# prompt; never put CONTROL_PLANE_API_KEY in this file.
