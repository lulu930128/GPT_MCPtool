# Explicit root allowlist. Add only directories you have reviewed. Each tool
# selects a root id and then a path relative to that root.
WORKSPACE_MCP_ROOTS=projects=C:\project;mcp_tools=C:\GPT_MCPtool;work=C:\work
WORKSPACE_MCP_DEFAULT_ROOT=projects

# Explicit media/document scopes. The value after each colon is a path relative
# to an existing root. Omit this variable to disable asset tools completely.
WORKSPACE_MCP_ASSET_SCOPES=projects=projects:.;mcp_tools=mcp_tools:.;work=work:.

# Optional root-specific directory exclusions:
# WORKSPACE_MCP_ROOT_DENY_DIRS=data=private-folder,restricted-folder

# Legacy single-root fallback:
# WORKSPACE_MCP_ROOT=C:\project

# ChatGPT/remote MCP endpoint settings.
WORKSPACE_MCP_HTTP_HOST=127.0.0.1
WORKSPACE_MCP_HTTP_PORT=8787

# Required if the HTTP endpoint is reachable outside trusted localhost.
# Generate a long random token when needed; do not commit a real value.
WORKSPACE_MCP_HTTP_TOKEN=

# Required only when creating a new Secure MCP Tunnel profile. Existing profiles
# retain their tunnel id under the ignored .tunnel-client directory.
WORKSPACE_MCP_TUNNEL_ID=

# Conservative output limits. Tune only after checking data exposure risk.
WORKSPACE_MCP_MAX_FILE_BYTES=262144
WORKSPACE_MCP_MAX_READ_LINES=300
WORKSPACE_MCP_MAX_SEARCH_RESULTS=80
WORKSPACE_MCP_MAX_DIR_ENTRIES=200
WORKSPACE_MCP_SEARCH_TIMEOUT_MS=8000

# Binary readers use separate source and response limits. Images are always
# re-encoded without metadata before they are returned.
WORKSPACE_MCP_MAX_IMAGE_FILE_BYTES=52428800
WORKSPACE_MCP_MAX_IMAGE_PIXELS=100000000
WORKSPACE_MCP_MAX_IMAGE_DIMENSION=4096
WORKSPACE_MCP_MAX_IMAGE_OUTPUT_BYTES=12582912
WORKSPACE_MCP_MAX_SPREADSHEET_FILE_BYTES=26214400
WORKSPACE_MCP_MAX_SPREADSHEET_EXPANDED_BYTES=104857600
WORKSPACE_MCP_MAX_SPREADSHEET_ZIP_ENTRIES=2048
WORKSPACE_MCP_MAX_SPREADSHEET_CELLS=5000
WORKSPACE_MCP_MAX_SPREADSHEET_ROWS=500
WORKSPACE_MCP_MAX_SPREADSHEET_COLUMNS=100
WORKSPACE_MCP_MAX_OFFICE_FILE_BYTES=104857600
WORKSPACE_MCP_MAX_OFFICE_EXPANDED_BYTES=524288000
WORKSPACE_MCP_MAX_OFFICE_ZIP_ENTRIES=4096
WORKSPACE_MCP_MAX_OFFICE_XML_PART_BYTES=10485760
WORKSPACE_MCP_MAX_OFFICE_XML_TOTAL_BYTES=52428800
WORKSPACE_MCP_MAX_OFFICE_TEXT_CHARS=100000
WORKSPACE_MCP_MAX_DOCUMENT_BLOCKS=300
WORKSPACE_MCP_MAX_DOCUMENT_TABLE_CELLS=5000
WORKSPACE_MCP_MAX_PRESENTATION_SLIDES=50

# Optional global semicolon-separated additions.
# WORKSPACE_MCP_EXTRA_DENY_DIRS=.tmp;private
# WORKSPACE_MCP_EXTRA_DENY_EXTENSIONS=.parquet;.zip
