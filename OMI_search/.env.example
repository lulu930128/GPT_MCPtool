OMI_SEARCH_API_BASE_URL=http://127.0.0.1:8400
OMI_SEARCH_API_TIMEOUT_SECONDS=90
OMI_SEARCH_SCHEMA_TIMEOUT_SECONDS=2

# Optional. Use this only when the OMI backend requires the trust-token header.
# The adapter never reads or forwards OpenAI API keys.
OMI_SEARCH_AI_TRUST_TOKEN=

# HTTP MCP endpoint for ChatGPT web through Secure MCP Tunnel.
OMI_SEARCH_MCP_HTTP_HOST=127.0.0.1
OMI_SEARCH_MCP_HTTP_PORT=8797

# Optional Bearer token for /mcp if you are not using a trusted localhost-only
# tunnel setup. Do not use this as a replacement for proper public auth.
OMI_SEARCH_MCP_HTTP_TOKEN=

# Required only when creating a new Secure MCP Tunnel profile. Existing profiles
# retain their tunnel id under the ignored .tunnel-client directory.
OMI_SEARCH_TUNNEL_ID=
