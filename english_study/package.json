{
  "name": "english-study-mcp",
  "version": "0.2.0",
  "description": "Private MCP adapter for English Study Hub.",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "bin": {
    "english-study-mcp": "./dist/src/http-main.js",
    "english-study-mcp-stdio": "./dist/src/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/config.test.js dist/tests/api-client.test.js dist/tests/server.test.js",
    "smoke:http": "npm run build && node scripts/smoke-http.mjs",
    "smoke:live": "npm run build && node scripts/smoke-live.mjs",
    "start": "node dist/src/http-main.js",
    "start:http": "node dist/src/http-main.js",
    "start:stdio": "node dist/src/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20"
  }
}
