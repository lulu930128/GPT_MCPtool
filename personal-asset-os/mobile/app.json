{
  "expo": {
    "name": "Personal Asset OS",
    "slug": "personal-asset-os-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "personalassetos",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.personalassetos.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#F7F0E7",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F0E7",
          "dark": {
            "backgroundColor": "#F7F0E7"
          }
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "./plugins/withLoopbackNetworkSecurity"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
