MEMORY_CORE_ENVIRONMENT=development
MEMORY_CORE_HOST=127.0.0.1
MEMORY_CORE_PORT=18765
MEMORY_CORE_DATA_DIR=data
MEMORY_CORE_LOG_LEVEL=INFO

# Keep empty to disable browser CORS. When needed, provide JSON.
# MEMORY_CORE_ALLOWED_ORIGINS=["http://127.0.0.1:3000"]

# MCP adapter non-secret settings. Keep MEMORY_CORE_MCP_CLIENT_TOKEN and
# MEMORY_CORE_MCP_REVIEW_CLIENT_TOKEN out of this file; provide them only through
# the MCP process environment or a local secret-store launcher. The review token
# is optional and should carry candidates:review only.
MEMORY_CORE_MCP_API_BASE_URL=http://127.0.0.1:18765
MEMORY_CORE_MCP_HOST=127.0.0.1
MEMORY_CORE_MCP_PORT=8818
MEMORY_CORE_MCP_API_TIMEOUT_SECONDS=15
MEMORY_CORE_MCP_MAX_CONTENT_CHARS=30000
# Temporary migration switch only. Keep false for the formal ChatGPT action surface.
MEMORY_CORE_MCP_EXPOSE_LEGACY_CANDIDATE_TOOL=false
